generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Video {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  description String?
  thumbnailUrl String?
  hlsUrl      String
  duration    Int?
  published   Boolean    @default(false)
  publishedAt DateTime?
  categoryId  String     @db.Uuid
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId, published])
  @@index([published, publishedAt])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  videos      Video[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveStream {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  hlsUrl      String
  status      LiveStreamStatus @default(OFFLINE)
  posterUrl   String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

enum LiveStreamStatus {
  OFFLINE
  LIVE
  SCHEDULED
}
