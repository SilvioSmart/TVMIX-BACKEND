generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String           @id @default(uuid()) @db.Uuid
  email                    String           @unique
  passwordHash             String
  name                     String?
  role                     UserRole         @default(USER)
  permissions              UserPermission[] @default([])
  emailVerifiedAt          DateTime?
  emailVerificationHash    String?
  emailVerificationExpires DateTime?
  passwordResetHash        String?
  passwordResetExpires     DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([createdAt])
  @@index([emailVerificationHash])
  @@index([passwordResetHash])
}

model Video {
  id               String                @id @default(uuid()) @db.Uuid
  title            String
  slug             String                @unique
  shortDescription String?
  description      String?
  thumbnailUrl String?
  hlsUrl           String?
  vastUrl          String?
  sourceObjectKey  String?
  originalFileName String?
  uploadedBy       String?
  processingStatus VideoProcessingStatus @default(PENDING)
  processingError  String?
  duration         Int?
  mediaFormat      String?
  videoQuality     String?
  audioTracks      Json?
  convertedObjectKey String?
  published        Boolean               @default(false)
  publishedAt      DateTime?
  categoryId       String                @db.Uuid
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  carouselSlides   HomepageCarouselSlide[]
  homeModuleItems  HomeModuleItem[]
  liveEpgItems     LiveEpgItem[]
  seasonId         String?               @db.VarChar(6)
  season           Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeNumber    Int?
  episodeCode      String?               @unique @db.VarChar(6)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([categoryId, published])
  @@index([published, publishedAt])
  @@index([seasonId])
  @@index([episodeCode])
}

model MediaUploadSession {
  id                String            @id @default(uuid()) @db.Uuid
  logicalUploadId   String            @unique @db.Uuid
  multipartUploadId String
  objectKey         String
  fileName          String
  contentType       String
  size              BigInt
  partSize          Int
  totalParts        Int
  uploadedParts     Json              @default("[]")
  status            MediaUploadStatus @default(IN_PROGRESS)
  error             String?
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completedAt       DateTime?
  abortedAt         DateTime?

  @@index([status, updatedAt])
  @@index([objectKey])
}

model RouteConfig {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  protocol    String
  host        String?
  port        Int?
  username    String?
  authMode    String?
  passwordSecret String?
  remotePath  String?
  importPath  String
  enabled     Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, name])
}

model HomepageCarouselSlide {
  id          String   @id @default(uuid()) @db.Uuid
  eyebrow     String?
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  ctaLabel    String?
  ctaUrl      String?
  sortOrder   Int
  published   Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  videoId     String?  @db.Uuid
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([videoId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  videos      Video[]
  programs    Program[]
  homeModules HomeModule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Program {
  id          String    @id @db.VarChar(5)
  name        String
  slug        String    @unique
  description String?
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seasons     Season[]
  homeModules HomeModule[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId, name])
}

model Season {
  id        String   @id @db.VarChar(6)
  number    Int
  title     String?
  programId String   @db.VarChar(5)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  episodes  Video[]
  homeModules HomeModule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, number])
  @@index([programId, number])
}

model LiveStream {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  streamType  LiveStreamType   @default(LIVE_STREAMING)
  hlsUrl      String
  status      LiveStreamStatus @default(OFFLINE)
  posterUrl   String?
  startedAt   DateTime?
  endedAt     DateTime?
  homeModules HomeModule[]
  epgItems    LiveEpgItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

model HomeModule {
  id           String              @id @default(uuid()) @db.Uuid
  title        String
  subtitle     String?
  type         HomeModuleType
  queryType    HomeModuleQueryType @default(LATEST)
  sortMethod   HomeModuleSortMethod @default(RECENT)
  sortOrder    Int
  enabled      Boolean             @default(true)
  limit        Int                 @default(12)
  categoryId   String?             @db.Uuid
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  programId    String?             @db.VarChar(5)
  program      Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  seasonId     String?             @db.VarChar(6)
  season       Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  liveStreamId String?             @db.Uuid
  liveStream   LiveStream?         @relation(fields: [liveStreamId], references: [id], onDelete: SetNull)
  items        HomeModuleItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([enabled, sortOrder])
  @@index([type, enabled])
  @@index([categoryId])
  @@index([programId])
  @@index([seasonId])
  @@index([liveStreamId])
}

model HomeModuleItem {
  id        String     @id @default(uuid()) @db.Uuid
  moduleId  String     @db.Uuid
  module    HomeModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videoId   String     @db.Uuid
  video     Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sortOrder Int
  createdAt DateTime   @default(now())

  @@unique([moduleId, videoId])
  @@index([moduleId, sortOrder])
  @@index([videoId])
}

model LiveEpgItem {
  id           String     @id @default(uuid()) @db.Uuid
  liveStreamId String     @db.Uuid
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  videoId      String?    @db.Uuid
  video        Video?     @relation(fields: [videoId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([liveStreamId, startsAt])
  @@index([videoId])
  @@index([startsAt, endsAt])
}

model AppearanceMenuItem {
  key         String   @id @db.VarChar(32)
  label       String
  description String?
  sortOrder   Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model FrontendMenuItem {
  id        String            @id @default(uuid()) @db.Uuid
  label     String
  url       String
  placement MenuItemPlacement @default(HEADER)
  placements MenuItemPlacement[] @default([HEADER])
  sortOrder Int
  enabled   Boolean           @default(true)
  external  Boolean           @default(false)
  parentId  String?           @db.Uuid
  parent    FrontendMenuItem?  @relation("FrontendMenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  FrontendMenuItem[] @relation("FrontendMenuTree")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([placement, enabled, sortOrder])
  @@index([parentId])
}

model NoticeArticle {
  id              String   @id @default(uuid()) @db.Uuid
  category        String
  categoryId      String?  @db.Uuid
  title           String
  slug            String   @unique
  excerpt         String?
  body            String
  imageUrl        String
  imageObjectKey  String?
  vastUrl         String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(false)
  publishedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  newsCategory    NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@index([sortOrder, createdAt])
  @@index([category])
  @@index([categoryId])
}

model NewsCategory {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  description String?
  color       String?
  sortOrder   Int             @default(0)
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  notices     NoticeArticle[]

  @@index([enabled, sortOrder])
  @@index([name])
}

model Tg9Video {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  slug           String   @unique
  description    String?
  videoUrl       String
  videoObjectKey String?
  posterUrl      String?
  sortOrder      Int      @default(0)
  published      Boolean  @default(false)
  publishedAt    DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([publishedAt])
}

enum LiveStreamStatus {
  OFFLINE
  LIVE
  SCHEDULED
}

enum LiveStreamType {
  LIVE_STREAMING
  PLAYLIST
}

enum MediaUploadStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  FAILED
}

enum MenuItemPlacement {
  HEADER
  FOOTER
  MOBILE
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum UserPermission {
  CONTENT_VIEW
  CONTENT_MANAGE
  CATALOG_MANAGE
  LIVE_MANAGE
  APPEARANCE_MANAGE
  USERS_MANAGE
  SETTINGS_MANAGE
  HLS_MANAGE
  VAST_MANAGE
}

enum VideoProcessingStatus {
  PENDING
  UPLOADING
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum HomeModuleType {
  CAROUSEL_SLIDER
  LIVE_EPG
  POSTER_RAIL
}

enum HomeModuleQueryType {
  LATEST
  CATEGORY
  PROGRAM
  SEASON
  MANUAL
  LIVE
}

enum HomeModuleSortMethod {
  RECENT
  OLDEST
  TITLE_ASC
}
