NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://tvmix:password@localhost:5432/tvmix?schema=public
JWT_SECRET=sostituisci-con-un-segreto-casuale-di-almeno-32-caratteri
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Frontend autorizzati per chiamate browser.
CORS_ORIGINS=https://www.tvmix.it,https://tvmix.it

# Coda condivisa con TVMIX-WORKER.
# Se Redis gira sul server worker, usa l'IP privato Hetzner del worker:
# REDIS_URL=redis://10.x.x.x:6379
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=tvmix-video-transcoding

# Segreti server-to-server.
# INTERNAL_API_SECRET protegge POST /api/v1/videos/:id/transcode.
# WEBHOOK_SECRET deve essere identico a quello configurato sul worker.
INTERNAL_API_SECRET=sostituisci-con-un-segreto-casuale
WEBHOOK_SECRET=change-me
